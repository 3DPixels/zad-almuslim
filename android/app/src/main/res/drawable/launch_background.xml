<?xml version="1.0" encoding="utf-8"?>
<!-- Modify this file to customize your launch splash screen -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. Pure XML vertical gradient matching ic_launcher_background -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/splash_gradient_start"
                android:centerColor="@color/splash_gradient_center"
                android:endColor="@color/splash_gradient_end"
                android:type="linear" />
        </shape>
    </item>

    <!-- 2. Centered foreground logo -->
    <item
        android:width="144dp"
        android:height="144dp"
        android:drawable="@mipmap/ic_launcher_monochrome"
        android:gravity="center" />
</layer-list>